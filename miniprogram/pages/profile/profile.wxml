<view class="page">
  <!-- 个人信息卡 -->
  <view class="profile-card">
    <image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" />
    <view wx:else class="avatar">{{avatarText}}</view>
    <view class="p-meta">
      <text class="p-name">{{profile.name}}</text>
      <text class="p-id">{{profile.id}}</text>
      <text class="p-desc">{{profile.desc}}</text>
    </view>
    <view class="p-edit" bindtap="onAuthTap">{{isLogged ? '退出' : '微信登录'}}</view>
  </view>

  <!-- 统计 -->
  <view class="stats-card">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <text class="stat-val">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-card">
    <view
      class="menu-row"
      wx:for="{{menus}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMenu"
    >
      <text class="menu-ico">{{item.icon}}</text>
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-desc">{{item.desc}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="disclaimer">
    <text class="dc-title">免责声明</text>
    <text class="dc-text">本页数据由实时行情接口与本地模拟生成，仅供功能演示，不构成任何投资建议。</text>
  </view>
</view>

<!-- 微信登录弹窗：头像 + 昵称填写能力 -->
<view class="login-overlay" wx:if="{{showLogin}}" catchtouchmove="noop" bindtap="closeLogin">
  <view class="login-modal" catchtap="noop">
    <text class="login-title">完善社区资料</text>
    <text class="login-sub">用于在讨论区展示你的头像和昵称</text>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{draftAvatar}}" class="avatar-preview" src="{{draftAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text class="ap-plus">＋</text>
        <text class="ap-tip">选择头像</text>
      </view>
    </button>

    <input
      class="nick-input"
      type="nickname"
      placeholder="点击填写微信昵称"
      placeholder-class="nick-ph"
      value="{{draftName}}"
      bindinput="onNickInput"
      bindblur="onNickInput"
      maxlength="20"
    />

    <view class="login-actions">
      <view class="login-cancel" catchtap="closeLogin">取消</view>
      <view class="login-confirm" catchtap="confirmLogin">完成登录</view>
    </view>
  </view>
</view>
