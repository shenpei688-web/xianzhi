page {
  background: #f4f6fb;
}

.page {
  min-height: 100vh;
  padding: 40rpx 0 calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── 个人信息卡 ── */
.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0b3bd6 0%, #1f7cff 55%, #46a3ff 100%);
  box-shadow: 0 10rpx 30rpx rgba(11, 59, 214, 0.28);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: #1f7cff;
  background: #ffffff;
}

.p-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.p-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.p-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

.p-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
}

.p-edit {
  align-self: flex-start;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.18);
}

/* ── 统计 ── */
.stats-card {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 28rpx 0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 75, 0.04);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-val {
  font-size: 40rpx;
  font-weight: 900;
  color: #1f7cff;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 22rpx;
  color: #8a93a7;
}

/* ── 菜单 ── */
.menu-card {
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 75, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f1f4f9;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-ico {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #1f7cff;
  background: #eaf1ff;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1f2a44;
}

.menu-desc {
  font-size: 24rpx;
  color: #8a93a7;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c2cad8;
}

/* ── 免责声明 ── */
.disclaimer {
  margin: 28rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dc-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #8a93a7;
}

.dc-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #aab1bf;
}

/* ── 登录弹窗 ── */
.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal {
  width: 560rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2a44;
}

.login-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a93a7;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  margin: 36rpx 0 28rpx;
  padding: 0;
  border-radius: 50%;
  background: #f4f6fb;
  border: 1rpx solid #e8edf5;
  overflow: hidden;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.ap-plus {
  font-size: 44rpx;
  color: #1f7cff;
  font-weight: 300;
  line-height: 1;
}

.ap-tip {
  font-size: 22rpx;
  color: #8a93a7;
}

.nick-input {
  width: 100%;
  height: 84rpx;
  background: #f4f6fb;
  border: 1rpx solid #e8edf5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2a44;
}

.nick-ph {
  color: #aab1bf;
}

.login-actions {
  display: flex;
  width: 100%;
  gap: 20rpx;
  margin-top: 36rpx;
}

.login-cancel,
.login-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.login-cancel {
  color: #8a93a7;
  background: #f1f4f9;
}

.login-confirm {
  color: #ffffff;
  background: linear-gradient(135deg, #1f7cff, #0b3bd6);
}
