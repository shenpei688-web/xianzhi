page {
  background: #f4f6fb;
  color: #1f2a44;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2a44;
  margin-bottom: 12rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #8a93a7;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 75, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a44;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #8a93a7;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  font-size: 22rpx;
  color: #8a93a7;
  margin-top: 16rpx;
}

.price {
  color: #ff3b30;
  font-weight: 700;
  font-size: 32rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #f1f4f9;
  color: #6b7790;
  margin-right: 12rpx;
  margin-top: 12rpx;
}

.tag-green {
  background: rgba(25, 181, 97, 0.14);
  color: #19b561;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #aab1bf;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #aab1bf;
}

.search-bar {
  background: #ffffff;
  border: 1rpx solid #e8edf5;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  color: #1f2a44;
  font-size: 28rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #ffffff;
  color: #8a93a7;
  border: 1rpx solid #e8edf5;
}

.filter-btn.active {
  background: #1f7cff;
  color: #ffffff;
  border-color: #1f7cff;
}

.filter-btn.active-green {
  background: #19b561;
  color: #fff;
  border-color: #19b561;
}

.filter-btn.active-purple {
  background: #7c3aed;
  color: #fff;
  border-color: #7c3aed;
}

.filter-btn.active-amber {
  background: #f59e0b;
  color: #fff;
  border-color: #f59e0b;
}

.item-img {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: #eef1f6;
}

.card-with-img {
  padding: 0;
  overflow: hidden;
}

.card-body {
  padding: 24rpx 28rpx 28rpx;
}

.btn-link {
  color: #1f7cff;
  font-size: 26rpx;
  margin-top: 24rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  min-width: 200rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 75, 0.04);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2a44;
}

.stat-label {
  font-size: 24rpx;
  color: #8a93a7;
  margin-top: 8rpx;
}
